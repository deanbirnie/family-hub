{
  "name": "@family-hub/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Family Hub for Android: the shared interface in a Capacitor shell, unlocked with biometrics",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node e2e/smoke.mjs",
    "sync": "vite build && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@family-hub/ui": "*",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "vite": "^8.3.8"
  }
}
